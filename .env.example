# Application Port
PORT=3000

# Server Host
HOST=0.0.0.0

# Environment mode (development, production, test)
NODE_ENV=development

# API Prefix
API_PREFIX=/api/v1

# ===================================================================
# Browser Extension Store API Credentials (for CLI automated upload)
# ===================================================================

# Mozilla Add-ons (Firefox AMO): https://addons.mozilla.org/developers/addon/api/key/
AMO_JWT_ISSUER=
AMO_JWT_SECRET=
AMO_CHANNEL=listed

# Chrome Web Store: https://github.com/fregante/chrome-webstore-upload/blob/main/How%20to%20generate%20Google%20API%20keys.md
CHROME_EXTENSION_ID=
CHROME_PUBLISHER_ID=
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=
CHROME_REFRESH_TOKEN=

# Apple App Store Connect: https://appstoreconnect.apple.com/access/integrations/api
APPLE_APP_ID=6835107571
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_PRIVATE_KEY_PATH=
