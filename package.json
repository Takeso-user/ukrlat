{
  "name": "ukrlat",
  "version": "1.2.1",
  "description": "Latin alphabet for Ukrainian transliteration",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:runner": "bun run scripts/run-tests.ts",
    "test:extension": "cd extension && bun test",
    "test:all": "bun test && cd extension && bun test",
    "typecheck": "tsc --noEmit && cd extension && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "build:extension": "cd extension && bun run build",
    "keyboard:build": "bun run keyboard/build.ts",
    "keyboard:install": "bun run keyboard/install.ts",
    "keyboard:ios:sync": "bun run keyboard/sync-ios.ts",
    "version:patch": "bun run scripts/bump-version.ts patch",
    "version:minor": "bun run scripts/bump-version.ts minor",
    "version:major": "bun run scripts/bump-version.ts major",
    "publish:patch": "bun run scripts/publish-all.ts patch",
    "publish:minor": "bun run scripts/publish-all.ts minor",
    "publish:major": "bun run scripts/publish-all.ts major",
    "publish:all": "bun run scripts/publish-all.ts patch",
    "publish:firefox": "bun run scripts/publish-firefox.ts",
    "publish:chrome": "bun run scripts/publish-chrome.ts",
    "publish:safari": "bun run scripts/publish-safari.ts",
    "status": "bun run scripts/status.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takeso-user/ukrlat.git"
  },
  "keywords": [
    "ukrlat",
    "alphabet",
    "transliteration",
    "bun",
    "typescript",
    "firefox-extension",
    "chrome-extension",
    "safari-extension"
  ],
  "author": "takeso-user",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Takeso-user/ukrlat/issues"
  },
  "homepage": "https://github.com/Takeso-user/ukrlat#readme",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/bun": "^1.4.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/semver": "^7.5.8",
    "chrome-webstore-upload-cli": "^4.0.2",
    "semver": "^7.6.3",
    "typescript": "7.0.2",
    "web-ext": "^10.8.0"
  }
}
