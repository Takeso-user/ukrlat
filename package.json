{
  "name": "ukrlat",
  "version": "1.0.0",
  "description": "Latin alphabet for Ukrainian transliteration",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "test": "bun test",
    "test:extension": "cd extension && bun test",
    "test:all": "bun test && cd extension && bun test",
    "build:extension": "cd extension && bun run build",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Takeso-user/ukrlat.git"
  },
  "keywords": [
    "ukrlat",
    "alphabet",
    "transliteration",
    "bun",
    "typescript"
  ],
  "author": "takeso-user",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Takeso-user/ukrlat/issues"
  },
  "homepage": "https://github.com/Takeso-user/ukrlat#readme",
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "bun-types": "^1.1.42",
    "typescript": "^5.7.2"
  }
}