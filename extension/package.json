{
  "name": "ukrlat-extension",
  "version": "1.0.0",
  "description": "Cross-browser extension for UkrLat transliteration (Firefox, Chrome, Safari)",
  "type": "module",
  "scripts": {
    "build": "bun run build.ts",
    "build:firefox": "bun run build.ts --target=firefox",
    "build:chrome": "bun run build.ts --target=chrome",
    "build:safari": "bun run build.ts --target=safari",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.280",
    "bun-types": "^1.1.42",
    "typescript": "^5.7.2"
  }
}
